<% layout("layouts/boilerplate.ejs") %>
<%
    const fallbackImage = "https://static.vecteezy.com/system/resources/thumbnails/057/068/323/small/single-fresh-red-strawberry-on-table-green-background-food-fruit-sweet-macro-juicy-plant-image-photo.jpg";
    const imageUrl = listed.image && listed.image.url ? listed.image.url : fallbackImage;
    const price = Number(listed.price);
    const hasPrice = Number.isFinite(price) && price > 0;
%>
<script>
  const mapToken = <%- JSON.stringify(mapboxToken) %>;
  const listingCoordinates = <%- JSON.stringify((listed.geometry && Array.isArray(listed.geometry.coordinates) ? listed.geometry.coordinates : null)) %>;
  const listingLocation = <%- JSON.stringify(listed.location || '') %>;
  const listingCountry = <%- JSON.stringify(listed.country || '') %>;
  const mapContainerId = 'map';
</script>

<section class="show-listing">
    <img src="<%= imageUrl %>" class="show-listing-img" alt="<%= listed.title || 'Listing image' %>">
    <div class="show-listing-content">
        <p class="section-kicker">Listing details</p>
        <h1><%= listed.title || "Untitled listing" %></h1>
        <i>
          Owner :
          <b><%= (listed.owner && listed.owner.username) ? listed.owner.username : "Unknown" %></b>
        </i>
        <br>
        <p><%= listed.description || "No description available." %></p>
        <ul class="show-listing-meta">
            <li>
                <strong>Price:</strong>
                <% if (hasPrice) { %>
                    &#8377; <%= price.toLocaleString("en-IN") %> / night
                <% } else { %>
                    Not added
                <% } %>
            </li>
            <li><strong>Location:</strong> <%= listed.location || "Not added" %></li>
            <li><strong>Country:</strong> <%= listed.country || "Not added" %></li>
        </ul>
        <% if (currentUser && listed.owner && currentUser._id.equals(listed.owner._id)) { %>
        <a href="/listings/<%= listed._id %>/edit" class="btn btn-dark">Edit listing</a>
        <% } %>
    </div>
</section>

<% if (typeof review !== 'undefined' && review === '1') { %>
  <div class="alert alert-success" role="alert">
    Review saved successfully.
  </div>
<% } %>

<% if (currentUser && listed.owner && currentUser._id.equals(listed.owner._id)) { %>
<div class="mt-3">
    <form action="/listings/<%= listed._id %>?_method=DELETE" method="post">
        <button class="btn btn-outline-danger">Delete listing</button>
    </form>
</div>
<% } %>
<% if (currentUser) { %>
<div class="mt-3">
    <form action="/listings/<%= listed._id %>/reviews" method="get">
        <button class="btn btn-outline-primary">Add Review</button>
    </form>
</div>
<% } %>
<hr>

<h4>All reviews</h4>
<% if (!listed.reviews || listed.reviews.length === 0) { %>
  <p>No reviews yet.</p>
<% } else { %>
  <div class="reviews">
    <% for (let review of listed.reviews) { %>
      <div class="review col-6 mb-2 p-2 border rounded">
        <p class="mb-1">
          <strong>Owner:</strong>
          <%= review.owner && review.owner.username ? review.owner.username : "Unknown" %>
        </p>
        <p class="mb-1">
          <strong>Rating:</strong>
          <span class="starability-result" data-rating="<%= review.rating %>">
            <%= review.rating %> stars
          </span>
        </p>
        <p class="mb-0"><strong>Comment:</strong> <%= review.comment %></p>
        <% if (currentUser && review.owner && currentUser._id.equals(review.owner._id)) { %>
        <form action="/listings/<%= listed._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
          <button class="btn btn-outline-danger">Delete</button>
        </form>
        <% } %>
      </div>
    <% } %>
  </div>
<% } %>
<h5>Location map</h5>
<div id="map"></div>
<script src="/js/map.js"></script>

