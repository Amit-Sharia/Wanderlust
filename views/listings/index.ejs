<% layout("layouts/boilerplate.ejs") %>
<% const fallbackImage = "https://static.vecteezy.com/system/resources/thumbnails/057/068/323/small/single-fresh-red-strawberry-on-table-green-background-food-fruit-sweet-macro-juicy-plant-image-photo.jpg" %>

<section class="listings-hero mt-1 mb-4 text-center text-md-start">
  <div class="row align-items-center">
    <div class="col-md-7">
      <h1 class="display-6 fw-bold mb-1 text-dark">Find your next extraordinary stay</h1>
      <p class="text-muted mb-0">Discover villas, beach houses, cabins, and iconic city stays worldwide.</p>
    </div>
    <div class="col-md-5 text-md-end mt-2 mt-md-0">
      <div class="form-check form-switch d-inline-block p-2 bg-light rounded-pill border px-3 shadow-sm">
        <input class="form-check-input ms-0 me-2" type="checkbox" id="taxToggle" role="switch">
        <label class="form-check-label small fw-semibold text-dark" for="taxToggle">Display total before & after tax</label>
      </div>
    </div>
  </div>

  <!-- Filter Pills -->
  <div class="filters-scroll-container mt-3 mb-2">
    <div class="d-flex gap-2 pb-2 overflow-x-auto text-nowrap">
      <a href="/listings" class="btn btn-filter <%= !currentFilter ? 'active' : '' %>">
        <i class="fa-solid fa-fire me-1 text-danger"></i> All Stays
      </a>
      <a href="/listings?filter=trending<%= currentSearch ? '&search=' + encodeURIComponent(currentSearch) : '' %>" class="btn btn-filter <%= currentFilter === 'trending' ? 'active' : '' %>">
        <i class="fa-solid fa-chart-line me-1"></i> Trending
      </a>
      <a href="/listings?filter=iconic-cities<%= currentSearch ? '&search=' + encodeURIComponent(currentSearch) : '' %>" class="btn btn-filter <%= currentFilter === 'iconic-cities' ? 'active' : '' %>">
        <i class="fa-solid fa-city me-1"></i> Iconic Cities
      </a>
      <a href="/listings?filter=mountain<%= currentSearch ? '&search=' + encodeURIComponent(currentSearch) : '' %>" class="btn btn-filter <%= currentFilter === 'mountain' ? 'active' : '' %>">
        <i class="fa-solid fa-mountain me-1"></i> Mountain
      </a>
      <a href="/listings?filter=beach<%= currentSearch ? '&search=' + encodeURIComponent(currentSearch) : '' %>" class="btn btn-filter <%= currentFilter === 'beach' ? 'active' : '' %>">
        <i class="fa-solid fa-umbrella-beach me-1"></i> Beach
      </a>
      <a href="/listings?filter=pools<%= currentSearch ? '&search=' + encodeURIComponent(currentSearch) : '' %>" class="btn btn-filter <%= currentFilter === 'pools' ? 'active' : '' %>">
        <i class="fa-solid fa-water-ladder me-1"></i> Amazing Pools
      </a>
    </div>
  </div>
</section>

<% if (!allListings || allListings.length === 0) { %>
  <div class="card border-0 shadow-sm rounded-4 text-center py-5 my-3">
    <div class="card-body">
      <i class="fa-solid fa-compass-drafting text-muted fs-1 mb-3"></i>
      <h3 class="fw-bold">No stays found</h3>
      <p class="text-muted">Try clearing search filters or add your own listing!</p>
      <a href="/listings/new" class="btn btn-brand-primary rounded-pill px-4">Add your listing</a>
    </div>
  </div>
<% } else { %>
  <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 mb-5">
    <% for (let i = 0; i < allListings.length; i++) { %>
      <% const listing = allListings[i]; %>
      <% const listImages = (listing.images && listing.images.length > 0) ? listing.images : [{ url: (listing.image && listing.image.url ? listing.image.url : fallbackImage) }]; %>
      <% const title = listing.title || "Untitled Stay" %>
      <% const price = Number(listing.price) %>
      <% const hasPrice = Number.isFinite(price) && price > 0 %>
      <% const locationParts = [listing.location, listing.country].filter(Boolean) %>

      <div class="col">
        <article class="card listing-card border-0 shadow-sm rounded-4 h-100 position-relative overflow-hidden">
          <!-- Card Image / Carousel -->
          <div class="position-relative">
            <% if (listImages.length > 1) { %>
              <div id="carouselListing<%= i %>" class="carousel slide" data-bs-ride="false" data-bs-interval="false">
                <div class="carousel-inner rounded-top-4">
                  <% listImages.forEach((img, idx) => { %>
                    <div class="carousel-item <%= idx === 0 ? 'active' : '' %>">
                      <a href="/listings/<%= listing._id %>">
                        <img src="<%= img.url %>" class="d-block w-100 listing-img" alt="<%= title %>" loading="lazy" style="height: 240px; object-fit: cover;">
                      </a>
                    </div>
                  <% }) %>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselListing<%= i %>" data-bs-slide="prev" onclick="event.preventDefault(); event.stopPropagation();">
                  <span class="carousel-control-prev-icon rounded-circle bg-dark bg-opacity-50 p-2" aria-hidden="true"></span>
                  <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselListing<%= i %>" data-bs-slide="next" onclick="event.preventDefault(); event.stopPropagation();">
                  <span class="carousel-control-next-icon rounded-circle bg-dark bg-opacity-50 p-2" aria-hidden="true"></span>
                  <span class="visually-hidden">Next</span>
                </button>
              </div>
            <% } else { %>
              <a href="/listings/<%= listing._id %>">
                <img src="<%= listImages[0].url %>" class="card-img-top listing-img rounded-top-4" alt="<%= title %>" loading="lazy" style="height: 240px; object-fit: cover;">
              </a>
            <% } %>

            <!-- Status Badge -->
            <% if (listing.isBooked) { %>
              <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill shadow-sm">
                <i class="fa-solid fa-lock me-1"></i> BOOKED
              </span>
            <% } else { %>
              <span class="badge bg-success bg-opacity-90 position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill shadow-sm">
                Available
              </span>
            <% } %>
          </div>

          <!-- Card Content -->
          <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark flex-grow-1 d-flex flex-column">
            <div class="card-body p-3.5 d-flex flex-column">
              <div class="d-flex justify-content-between align-items-start mb-1">
                <h5 class="card-title fw-bold text-truncate mb-0" style="max-width: 75%;"><%= title %></h5>
                <div class="text-end">
                  <% if (hasPrice) { %>
                    <span class="fw-bold text-dark fs-6">₹ <%= price.toLocaleString("en-IN") %></span>
                    <small class="text-muted d-block" style="font-size: 0.75rem;">night</small>
                  <% } %>
                </div>
              </div>

              <p class="text-muted small text-truncate-2 mb-2 flex-grow-1"><%= listing.description || "No description provided." %></p>

              <div class="border-top pt-2 mt-auto d-flex align-items-center justify-content-between text-muted small">
                <span>
                  <i class="fa-solid fa-location-dot text-danger me-1"></i>
                  <%= locationParts.length ? locationParts.join(", ") : "Worldwide" %>
                </span>

                <% if (hasPrice) { %>
                  <% const amountAfterTax = price * 1.18 %>
                  <span class="tax-info-label d-none text-danger fw-semibold" style="font-size: 0.78rem;">
                    ₹ <%= Math.round(amountAfterTax).toLocaleString("en-IN") %> incl. tax
                  </span>
                <% } %>
              </div>
            </div>
          </a>
        </article>
      </div>
    <% } %>
  </div>
<% } %>

<script>
  // Toggle tax labels
  document.addEventListener("DOMContentLoaded", () => {
    const taxToggle = document.getElementById("taxToggle");
    if (taxToggle) {
      taxToggle.addEventListener("change", () => {
        const labels = document.querySelectorAll(".tax-info-label");
        labels.forEach(el => el.classList.toggle("d-none", !taxToggle.checked));
      });
    }
  });
</script>