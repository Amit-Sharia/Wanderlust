<% layout("layouts/boilerplate.ejs") %>

<div class="row justify-content-center my-5">
  <div class="col-md-8 col-lg-6">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-sm-5 bg-white border-top border-4 border-danger">
      <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
          <i class="fa-solid fa-pen-nib text-danger"></i> Leave a Review
        </h2>
        <p class="text-muted small">Share your experience staying at <strong><%= listed.title %></strong></p>
      </div>

      <form class="needs-validation" action="/listings/<%= listed._id %>/reviews" method="post" novalidate>
        <div class="mb-4 rating-field">
          <label class="form-label fw-semibold text-secondary d-block">Rating</label>
          <fieldset class="starability-coinFlip">
            <legend class="visually-hidden">Choose a rating</legend>
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" aria-label="No rating." required />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" required />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
            <span class="starability-focus-ring"></span>
          </fieldset>
          <div class="invalid-feedback rating-feedback text-danger">Please choose a star rating.</div>
        </div>


        <div class="mb-4">
          <label for="comment" class="form-label fw-semibold text-secondary">Comments & Review</label>
          <textarea
            class="form-control rounded-3"
            name="review[comment]"
            id="comment"
            rows="4"
            placeholder="What did you love about this stay? Was the host welcoming?"
            required
          ></textarea>
          <div class="invalid-feedback text-danger">Please enter a review comment.</div>
        </div>

        <div class="d-flex gap-2">
          <button class="btn btn-brand-primary px-4 py-2.5 rounded-3 fw-semibold flex-grow-1" type="submit">
            <i class="fa-solid fa-paper-plane me-1"></i> Submit Review
          </button>
          <a href="/listings/<%= listed._id %>" class="btn btn-outline-secondary px-4 py-2.5 rounded-3">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>
