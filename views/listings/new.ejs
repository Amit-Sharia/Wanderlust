<% layout("layouts/boilerplate.ejs") %>
<section class="form-shell">
    <h1>Add a new listing</h1>
    <form action="/listings" method="post" class="listing-form">
        <input class="form-control" name="listing[title]" type="text" placeholder="Title" required>
        <textarea class="form-control" name="listing[description]" rows="4" placeholder="Description"></textarea>
        <input class="form-control" name="listing[image][url]" type="url" placeholder="Image URL">
        <input class="form-control" name="listing[price]" type="number" min="0" placeholder="Price per night">
        <input class="form-control" name="listing[location]" type="text" placeholder="Location">
        <input class="form-control" name="listing[country]" type="text" placeholder="Country">
        <button class="btn btn-dark">Add listing</button>
    </form>
</section>
