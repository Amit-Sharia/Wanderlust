<% layout("layouts/boilerplate.ejs") %>

<div class="row justify-content-center my-5">
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
      <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1">Create a new stay listing</h2>
        <p class="text-muted">Fill out the details below to publish your property on Wanderlust</p>
      </div>

      <form action="/listings" method="post" class="needs-validation" novalidate enctype="multipart/form-data">
        <div class="mb-3">
          <label for="title" class="form-label fw-semibold text-secondary">Title</label>
          <input class="form-control rounded-3 py-2" id="title" name="title" type="text" placeholder="e.g. Cozy Beachfront Villa in Bali" required />
        </div>

        <div class="mb-3">
          <label for="description" class="form-label fw-semibold text-secondary">Description</label>
          <textarea class="form-control rounded-3" id="description" name="description" rows="4" placeholder="Describe the ambiance, amenities, view, and unique features..." required></textarea>
        </div>

        <div class="mb-3">
          <label for="images" class="form-label fw-semibold text-secondary">Upload Photos (Multiple files supported)</label>
          <input class="form-control rounded-3" id="images" name="images" type="file" accept="image/*" multiple />
          <small class="text-muted d-block mt-1">Select up to 5 photos for your stay listing</small>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <label for="price" class="form-label fw-semibold text-secondary">Price per night (₹)</label>
            <input class="form-control rounded-3 py-2" id="price" name="price" type="number" min="0" placeholder="2500" required />
          </div>
          <div class="col-md-4">
            <label for="location" class="form-label fw-semibold text-secondary">Location / City</label>
            <input class="form-control rounded-3 py-2" id="location" name="location" type="text" placeholder="Malibu" required />
          </div>
          <div class="col-md-4">
            <label for="country" class="form-label fw-semibold text-secondary">Country</label>
            <input class="form-control rounded-3 py-2" id="country" name="country" type="text" placeholder="United States" required />
          </div>
        </div>

        <div class="d-flex gap-2">
          <button class="btn btn-brand-primary px-4 py-2.5 rounded-3 fw-semibold" type="submit">
            <i class="fa-solid fa-plus-circle me-1"></i> Publish Stay Listing
          </button>
          <a href="/listings" class="btn btn-outline-secondary px-4 py-2.5 rounded-3">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>

