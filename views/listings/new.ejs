<% layout("layouts/boilerplate.ejs") %>
    <section class="form-shell">
        <h1>Add a new listing</h1>
<form action="/listings" method="post" class="listing-form needs-validation" novalidate>
            <input class="form-control" name="listing[title]" type="text" placeholder="Title" required>
            <textarea class="form-control" name="listing[description]" rows="4" placeholder="Description" required></textarea>
            <input class="form-control" name="listing[image][url]" type="url" placeholder="Image URL">
            <input class="form-control" name="listing[price]" type="number" min="0" placeholder="Price per night" required>
            <input class="form-control" name="listing[location]" type="text" placeholder="Location" required>
            <input class="form-control" name="listing[country]" type="text" placeholder="Country" required>
            <button class="btn btn-dark">Add listing</button>
        </form>
    </section>