<% layout("layouts/boilerplate.ejs") %>
    <section class="form-shell">
        <h1>Add a new listing</h1>
<form action="/listings" method="post" class="listing-form needs-validation" novalidate enctype="multipart/form-data">
            <input class="form-control" name="title" type="text" placeholder="Title" required>
            <textarea class="form-control" name="description" rows="4" placeholder="Description" required></textarea>
            <input class="form-control" name="image" type="file" accept="image/*">
            <input class="form-control" name="price" type="number" min="0" placeholder="Price per night" required>
            <input class="form-control" name="location" type="text" placeholder="Location" required>
            <input class="form-control" name="country" type="text" placeholder="Country" required>
            <button class="btn btn-dark">Add listing</button>
        </form>
    </section>
