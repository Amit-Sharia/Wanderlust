<% layout("layouts/boilerplate.ejs") %>

<div class="container my-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <!-- Chat Header -->
        <div class="card-header bg-dark text-white p-3 p-sm-4 d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center gap-3">
            <a href="/bookings/dashboard" class="btn btn-outline-light btn-sm rounded-circle p-2" title="Back to Dashboard">
              <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
              <h5 class="fw-bold mb-0 text-white"><%= booking.listing ? booking.listing.title : 'Stay Chat' %></h5>
              <small class="text-white-50">
                Chatting with <%= currentUser._id.equals(booking.owner._id) ? booking.renter.username + ' (Guest)' : booking.owner.username + ' (Host)' %>
              </small>
            </div>
          </div>
          <span class="badge bg-success rounded-pill px-3 py-2">BOOKED MODE</span>
        </div>

        <!-- Chat Body -->
        <div class="card-body p-4 bg-light chat-messages-box" style="height: 420px; overflow-y: auto;">
          <% if (!messages || messages.length === 0) { %>
            <div class="text-center text-muted my-5">
              <i class="fa-solid fa-comments fs-1 opacity-50 mb-2"></i>
              <p class="mb-0">No messages yet. Start the conversation!</p>
            </div>
          <% } else { %>
            <% for (let m of messages) { %>
              <% const isMine = m.sender && currentUser._id.equals(m.sender._id); %>
              <div class="d-flex mb-3 <%= isMine ? 'justify-content-end' : 'justify-content-start' %>">
                <div class="chat-bubble p-3 rounded-4 shadow-sm max-w-75 <%= isMine ? 'bg-danger text-white' : 'bg-white text-dark border' %>">
                  <div class="d-flex align-items-center gap-2 mb-1">
                    <strong class="small <%= isMine ? 'text-white-50' : 'text-primary' %>">
                      <%= m.sender ? m.sender.username : 'User' %>
                    </strong>
                    <span class="small opacity-50 text-nowrap" style="font-size: 0.75rem;">
                      <%= new Date(m.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                    </span>
                  </div>
                  <p class="mb-0 text-break"><%= m.text %></p>
                </div>
              </div>
            <% } %>
          <% } %>
        </div>

        <!-- Chat Footer Input -->
        <div class="card-footer bg-white p-3 border-top">
          <form action="/bookings/<%= booking._id %>/chat" method="POST" class="d-flex gap-2">
            <input
              type="text"
              name="text"
              class="form-control rounded-pill border-2 px-3 shadow-none"
              placeholder="Type your message..."
              required
              autocomplete="off"
            />
            <button type="submit" class="btn btn-brand-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px;">
              <i class="fa-solid fa-paper-plane"></i>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Auto scroll chat box to bottom
  document.addEventListener("DOMContentLoaded", () => {
    const box = document.querySelector(".chat-messages-box");
    if (box) box.scrollTop = box.scrollHeight;
  });
</script>
