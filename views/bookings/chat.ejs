<% layout("layouts/boilerplate.ejs") %>

<div class="container my-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card chat-card-custom shadow-sm border-0 rounded-4 overflow-hidden">
        <!-- Chat Header (Clean Red & White Header without LIVE CHAT logo) -->
        <div class="chat-header-custom text-white p-3 p-sm-4 d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center gap-3">
            <a href="/bookings/dashboard" class="chat-back-btn" title="Back to Dashboard">
              <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
              <h5 class="fw-bold mb-0 text-white"><%= booking.listing ? booking.listing.title : 'Stay Chat' %></h5>
              <small class="text-white-50">
                Chatting with <%= currentUser._id.equals(booking.owner._id) ? booking.renter.username + ' (Guest)' : booking.owner.username + ' (Host)' %>
              </small>
            </div>
          </div>
        </div>

        <!-- Chat Body -->
        <div class="card-body p-4 chat-messages-box" id="chatMessagesBox" style="height: 440px; overflow-y: auto;">
          <div id="messagesContainer">
            <% if (!messages || messages.length === 0) { %>
              <div class="text-center text-muted my-5" id="noMessagesPlaceholder">
                <i class="fa-solid fa-comments fs-1 opacity-50 mb-2 text-danger"></i>
                <p class="mb-0">No messages yet. Start the conversation!</p>
              </div>
            <% } else { %>
              <% for (let m of messages) { %>
                <% const isMine = m.sender && currentUser._id.equals(m.sender._id); %>
                <div class="d-flex mb-3 <%= isMine ? 'justify-content-end' : 'justify-content-start' %> message-row" data-msg-id="<%= m._id %>">
                  <div class="chat-bubble p-3 rounded-4 max-w-75 <%= isMine ? 'chat-bubble-mine' : 'chat-bubble-other' %>">
                    <div class="d-flex align-items-center justify-content-between gap-3 mb-1">
                      <strong class="small <%= isMine ? 'text-white-50' : 'text-danger' %>">
                        <%= m.sender ? m.sender.username : 'User' %>
                      </strong>
                      <span class="small opacity-75 text-nowrap msg-timestamp" style="font-size: 0.75rem;" data-created-at="<%= m.createdAt %>">
                        <!-- Formatted by client JS -->
                      </span>
                    </div>
                    <p class="mb-0 text-break" style="font-size: 0.95rem; line-height: 1.45;"><%= m.text %></p>
                  </div>
                </div>
              <% } %>
            <% } %>
          </div>
        </div>

        <!-- Chat Footer Input -->
        <div class="card-footer bg-white p-3 border-top border-rose-light">
          <form action="/bookings/<%= booking._id %>/chat" method="POST" class="d-flex align-items-center gap-2 no-loader" id="chatForm" data-no-loader="true">
            <div class="chat-input-pill d-flex align-items-center flex-grow-1">
              <input
                type="text"
                name="text"
                id="messageInput"
                class="form-control border-0 p-0 shadow-none bg-transparent"
                placeholder="Type your message..."
                required
                autocomplete="off"
              />
            </div>
            <button type="submit" id="sendBtn" class="btn btn-brand-primary rounded-circle p-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 46px; height: 46px;" title="Send Message">
              <i class="fa-solid fa-paper-plane"></i>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const currentUserId = "<%= currentUser._id %>";
    const bookingId = "<%= booking._id %>";
    const box = document.getElementById("chatMessagesBox");
    const container = document.getElementById("messagesContainer");
    const form = document.getElementById("chatForm");
    const input = document.getElementById("messageInput");
    const sendBtn = document.getElementById("sendBtn");

    const existingIds = new Set();

    // Helper to format ISO date into user's local timezone (12-hour AM/PM format)
    function formatLocalTime(dateStr) {
      if (!dateStr) return "";
      const d = new Date(dateStr);
      if (isNaN(d.getTime())) return "";

      const now = new Date();
      const isToday = d.toDateString() === now.toDateString();

      const timeStr = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: true });
      if (isToday) {
        return timeStr;
      }
      const dateStrFormatted = d.toLocaleDateString([], { month: 'short', day: 'numeric' });
      return `${dateStrFormatted}, ${timeStr}`;
    }

    // Format all initial timestamps
    document.querySelectorAll(".msg-timestamp").forEach((el) => {
      const createdAt = el.getAttribute("data-created-at");
      if (createdAt) {
        el.textContent = formatLocalTime(createdAt);
      }
    });

    // Collect initial message IDs
    document.querySelectorAll(".message-row").forEach((el) => {
      const id = el.getAttribute("data-msg-id");
      if (id) existingIds.add(id);
    });

    // Auto scroll to bottom
    function scrollToBottom() {
      if (box) {
        box.scrollTop = box.scrollHeight;
      }
    }
    scrollToBottom();

    // Render a new message bubble
    function appendMessageBubble(m) {
      if (existingIds.has(m._id)) return;
      existingIds.add(m._id);

      const placeholder = document.getElementById("noMessagesPlaceholder");
      if (placeholder) placeholder.remove();

      const isMine = m.sender && (m.sender._id === currentUserId || m.sender === currentUserId);
      const senderName = m.sender ? (m.sender.username || 'User') : 'User';
      const formattedTime = formatLocalTime(m.createdAt);

      const wrapper = document.createElement("div");
      wrapper.className = `d-flex mb-3 ${isMine ? 'justify-content-end' : 'justify-content-start'} message-row`;
      wrapper.setAttribute("data-msg-id", m._id);

      wrapper.innerHTML = `
        <div class="chat-bubble p-3 rounded-4 max-w-75 ${isMine ? 'chat-bubble-mine' : 'chat-bubble-other'}">
          <div class="d-flex align-items-center justify-content-between gap-3 mb-1">
            <strong class="small ${isMine ? 'text-white-50' : 'text-danger'}">
              ${escapeHtml(senderName)}
            </strong>
            <span class="small opacity-75 text-nowrap msg-timestamp" style="font-size: 0.75rem;">
              ${formattedTime}
            </span>
          </div>
          <p class="mb-0 text-break" style="font-size: 0.95rem; line-height: 1.45;">${escapeHtml(m.text)}</p>
        </div>
      `;

      container.appendChild(wrapper);
      scrollToBottom();
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // Async message submission (No full page refresh)
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (window.hideLoader) window.hideLoader();

      const text = input.value.trim();
      if (!text) return;

      input.value = "";
      sendBtn.disabled = true;

      try {
        const res = await fetch(`/bookings/${bookingId}/chat?json=true`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          body: JSON.stringify({ text })
        });

        const data = await res.json();
        if (data.success && data.message) {
          appendMessageBubble(data.message);
        }
      } catch (err) {
        console.error("Failed to send message:", err);
      } finally {
        sendBtn.disabled = false;
        if (window.hideLoader) window.hideLoader();
        input.focus();
      }
    });

    // Real-time polling every 2 seconds for new incoming messages
    async function pollMessages() {
      try {
        const res = await fetch(`/bookings/${bookingId}/messages/json`, {
          headers: { "Accept": "application/json" }
        });
        if (!res.ok) return;

        const data = await res.json();
        if (data.success && Array.isArray(data.messages)) {
          for (const m of data.messages) {
            if (!existingIds.has(m._id)) {
              appendMessageBubble(m);
            }
          }
        }
      } catch (err) {
        // Silent error handling for background polling
      }
    }

    setInterval(pollMessages, 2000);
  });
</script>
