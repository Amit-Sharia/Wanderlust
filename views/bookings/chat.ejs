<% layout("layouts/boilerplate.ejs") %>

<div class="container my-4">
  <div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
      <div class="card whatsapp-chat-card shadow-lg border-0 rounded-4 overflow-hidden">
        <!-- WhatsApp Red & White Chat Header -->
        <div class="whatsapp-chat-header text-white p-3 d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center gap-3">
            <a href="/bookings/dashboard" class="whatsapp-back-btn" title="Back to Dashboard">
              <i class="fa-solid fa-arrow-left"></i>
            </a>
            <% 
              const otherUser = currentUser._id.equals(booking.owner._id) ? booking.renter : booking.owner;
              const otherRole = currentUser._id.equals(booking.owner._id) ? 'Guest' : 'Host';
              const initial = otherUser && otherUser.username ? otherUser.username.charAt(0).toUpperCase() : 'U';
            %>
            <div class="whatsapp-avatar">
              <%= initial %>
            </div>
            <div>
              <h5 class="fw-bold mb-0 text-white" style="font-size: 1.1rem;">
                <%= booking.listing ? booking.listing.title : 'Stay Chat' %>
              </h5>
              <small class="text-white-50 d-flex align-items-center gap-1" style="font-size: 0.8rem;">
                <span class="bg-success rounded-circle d-inline-block" style="width: 8px; height: 8px;"></span>
                Chatting with <%= otherUser ? otherUser.username : 'User' %> (<%= otherRole %>)
              </small>
            </div>
          </div>

          <div class="d-none d-sm-block text-end">
            <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-1.5 fw-normal" style="font-size: 0.78rem;">
              <i class="fa-solid fa-shield-halved me-1"></i> Secure Stay Chat
            </span>
          </div>
        </div>

        <!-- Chat Body with WhatsApp Red/White Wallpaper -->
        <div class="card-body p-3 p-sm-4 whatsapp-chat-bg chat-messages-box" id="chatMessagesBox" style="height: 460px; overflow-y: auto;">
          <div class="date-divider mb-3">
            <span>TODAY</span>
          </div>
          
          <div id="messagesContainer">
            <% if (!messages || messages.length === 0) { %>
              <div class="text-center text-muted my-5" id="noMessagesPlaceholder">
                <div class="d-inline-flex align-items-center justify-content-center bg-white rounded-circle p-3 shadow-sm mb-3" style="width: 60px; height: 60px;">
                  <i class="fa-solid fa-comments fs-3 text-danger"></i>
                </div>
                <h6 class="fw-semibold text-dark mb-1">No messages yet</h6>
                <p class="small text-muted mb-0">Say hi to start discussing your stay details!</p>
              </div>
            <% } else { %>
              <% for (let m of messages) { %>
                <% const isMine = m.sender && currentUser._id.equals(m.sender._id); %>
                <div class="d-flex mb-3 <%= isMine ? 'justify-content-end' : 'justify-content-start' %> message-row" data-msg-id="<%= m._id %>">
                  <div class="p-3 max-w-75 <%= isMine ? 'whatsapp-bubble-mine' : 'whatsapp-bubble-other' %>">
                    <% if (!isMine) { %>
                      <div class="small text-danger fw-bold mb-1" style="font-size: 0.8rem;">
                        <%= m.sender ? m.sender.username : 'User' %>
                      </div>
                    <% } %>
                    <p class="mb-1 text-break" style="font-size: 0.95rem; line-height: 1.45;"><%= m.text %></p>
                    <div class="d-flex align-items-center <%= isMine ? 'justify-content-end text-white-50' : 'justify-content-end text-muted' %>" style="font-size: 0.7rem;">
                      <span class="msg-timestamp" data-created-at="<%= m.createdAt %>"></span>
                      <% if (isMine) { %>
                        <i class="fa-solid fa-check-double ms-1 text-white opacity-75" style="font-size: 0.75rem;"></i>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% } %>
            <% } %>
          </div>
        </div>

        <!-- Chat Footer Input Bar -->
        <div class="card-footer bg-white p-3 border-top border-rose-light">
          <form action="/bookings/<%= booking._id %>/chat" method="POST" class="d-flex align-items-center gap-2 no-loader" id="chatForm" data-no-loader="true">
            <div class="whatsapp-input-pill d-flex align-items-center flex-grow-1">
              <i class="fa-regular fa-face-smile text-danger fs-5 me-2 opacity-75"></i>
              <input
                type="text"
                name="text"
                id="messageInput"
                class="form-control border-0 p-0 shadow-none bg-transparent"
                placeholder="Type a message..."
                required
                autocomplete="off"
              />
            </div>
            <button type="submit" id="sendBtn" class="whatsapp-send-btn" title="Send Message">
              <i class="fa-solid fa-paper-plane fs-6"></i>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const currentUserId = "<%= currentUser._id %>";
    const bookingId = "<%= booking._id %>";
    const box = document.getElementById("chatMessagesBox");
    const container = document.getElementById("messagesContainer");
    const form = document.getElementById("chatForm");
    const input = document.getElementById("messageInput");
    const sendBtn = document.getElementById("sendBtn");

    const existingIds = new Set();

    // Helper to format ISO date into user's local timezone (12-hour AM/PM format)
    function formatLocalTime(dateStr) {
      if (!dateStr) return "";
      const d = new Date(dateStr);
      if (isNaN(d.getTime())) return "";

      const now = new Date();
      const isToday = d.toDateString() === now.toDateString();

      const timeStr = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: true });
      if (isToday) {
        return timeStr;
      }
      const dateStrFormatted = d.toLocaleDateString([], { month: 'short', day: 'numeric' });
      return `${dateStrFormatted}, ${timeStr}`;
    }

    // Format all initial timestamps
    document.querySelectorAll(".msg-timestamp").forEach((el) => {
      const createdAt = el.getAttribute("data-created-at");
      if (createdAt) {
        el.textContent = formatLocalTime(createdAt);
      }
    });

    // Collect initial message IDs
    document.querySelectorAll(".message-row").forEach((el) => {
      const id = el.getAttribute("data-msg-id");
      if (id) existingIds.add(id);
    });

    // Auto scroll to bottom
    function scrollToBottom() {
      if (box) {
        box.scrollTop = box.scrollHeight;
      }
    }
    scrollToBottom();

    // Render a new message bubble
    function appendMessageBubble(m) {
      if (existingIds.has(m._id)) return;
      existingIds.add(m._id);

      const placeholder = document.getElementById("noMessagesPlaceholder");
      if (placeholder) placeholder.remove();

      const isMine = m.sender && (m.sender._id === currentUserId || m.sender === currentUserId);
      const senderName = m.sender ? (m.sender.username || 'User') : 'User';
      const formattedTime = formatLocalTime(m.createdAt);

      const wrapper = document.createElement("div");
      wrapper.className = `d-flex mb-3 ${isMine ? 'justify-content-end' : 'justify-content-start'} message-row`;
      wrapper.setAttribute("data-msg-id", m._id);

      wrapper.innerHTML = `
        <div class="p-3 max-w-75 ${isMine ? 'whatsapp-bubble-mine' : 'whatsapp-bubble-other'}">
          ${!isMine ? `<div class="small text-danger fw-bold mb-1" style="font-size: 0.8rem;">${escapeHtml(senderName)}</div>` : ''}
          <p class="mb-1 text-break" style="font-size: 0.95rem; line-height: 1.45;">${escapeHtml(m.text)}</p>
          <div class="d-flex align-items-center ${isMine ? 'justify-content-end text-white-50' : 'justify-content-end text-muted'}" style="font-size: 0.7rem;">
            <span>${formattedTime}</span>
            ${isMine ? '<i class="fa-solid fa-check-double ms-1 text-white opacity-75" style="font-size: 0.75rem;"></i>' : ''}
          </div>
        </div>
      `;

      container.appendChild(wrapper);
      scrollToBottom();
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // Async message submission (No full page refresh)
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (window.hideLoader) window.hideLoader();

      const text = input.value.trim();
      if (!text) return;

      input.value = "";
      sendBtn.disabled = true;

      try {
        const res = await fetch(`/bookings/${bookingId}/chat?json=true`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          body: JSON.stringify({ text })
        });

        const data = await res.json();
        if (data.success && data.message) {
          appendMessageBubble(data.message);
        }
      } catch (err) {
        console.error("Failed to send message:", err);
      } finally {
        sendBtn.disabled = false;
        if (window.hideLoader) window.hideLoader();
        input.focus();
      }
    });

    // Real-time polling every 2 seconds for new incoming messages
    async function pollMessages() {
      try {
        const res = await fetch(`/bookings/${bookingId}/messages/json`, {
          headers: { "Accept": "application/json" }
        });
        if (!res.ok) return;

        const data = await res.json();
        if (data.success && Array.isArray(data.messages)) {
          for (const m of data.messages) {
            if (!existingIds.has(m._id)) {
              appendMessageBubble(m);
            }
          }
        }
      } catch (err) {
        // Silent error handling for background polling
      }
    }

    setInterval(pollMessages, 2000);
  });
</script>
