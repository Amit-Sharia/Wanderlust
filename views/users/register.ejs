<% layout("layouts/boilerplate.ejs") %>

<section class="form-shell">
  <h1>Create account</h1>

  <form action="/users/register" method="post" class="listing-form needs-validation" novalidate>
    <input class="form-control" type="text" name="username" placeholder="Username" required />
    <input class="form-control" type="email" name="email" placeholder="Email" required />
    <input class="form-control" type="password" name="password" placeholder="Password" required />

    <button class="btn btn-dark mt-2" type="submit">Register</button>
  </form>

  <p class="mt-2">Already have an account? <a href="/users/login">Log in</a></p>
</section>

