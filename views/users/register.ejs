<% layout("layouts/boilerplate.ejs") %>

<div class="row justify-content-center my-5">
  <div class="col-md-6 col-lg-5">
    <div class="card auth-card shadow-sm border-0 rounded-4 overflow-hidden">
      <div class="card-body p-4 p-sm-5">
        <div class="text-center mb-4">
          <div class="auth-icon-badge mb-3">
            <i class="fa-solid fa-user-plus text-danger fs-3"></i>
          </div>
          <h2 class="fw-bold text-dark">Join Wanderlust</h2>
          <p class="text-muted small">Create an account to book stays and share your listings</p>
        </div>

        <form action="/users/register" method="post" class="needs-validation" novalidate>
          <div class="mb-3">
            <label for="username" class="form-label small fw-semibold text-secondary">Username</label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-at text-muted"></i></span>
              <input 
                class="form-control border-start-0 bg-light" 
                id="username" 
                type="text" 
                name="username" 
                placeholder="johndoe" 
                required 
                minlength="3"
                pattern="^[a-zA-Z0-9_]+$"
                autocomplete="off"
              />
            </div>
            <div id="usernameStatus" class="mt-2 small"></div>
            <small class="text-muted d-block mt-1">Your unique handle on Wanderlust for your profile, bookings, and host listings.</small>
          </div>

          <div class="mb-3">
            <label for="email" class="form-label small fw-semibold text-secondary">Email address</label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-envelope text-muted"></i></span>
              <input class="form-control border-start-0 bg-light" id="email" type="email" name="email" placeholder="john@example.com" required />
            </div>
          </div>

          <div class="mb-3">
            <label for="password" class="form-label small fw-semibold text-secondary">Password</label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-lock text-muted"></i></span>
              <input class="form-control border-start-0 bg-light" id="password" type="password" name="password" placeholder="••••••••" required />
            </div>
            <!-- Password Strength Bar -->
            <div class="password-strength-container mt-2">
              <div class="progress" style="height: 6px;">
                <div id="passwordStrengthBar" class="progress-bar bg-danger" role="progressbar" style="width: 0%;"></div>
              </div>
              <small id="passwordStrengthText" class="text-muted small mt-1 d-block">Min 8 chars with uppercase, number & symbol</small>
            </div>
          </div>

          <!-- Captcha Challenge -->
          <div class="mb-4">
            <label for="captcha" class="form-label small fw-semibold text-secondary">Security Verification</label>
            <div class="d-flex align-items-center gap-3">
              <img src="<%= typeof captchaSvg !== 'undefined' ? captchaSvg : '' %>" alt="Captcha" class="rounded border shadow-sm" height="42" />
              <input class="form-control bg-light" id="captcha" type="text" name="captcha" placeholder="Enter answer" required />
            </div>
          </div>

          <button class="btn btn-brand-primary w-100 py-2.5 fw-semibold rounded-3 mb-3" type="submit" id="submitBtn">Create Account</button>
        </form>

        <div class="position-relative my-4 text-center">
          <hr class="text-muted opacity-25" />
          <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">or continue with</span>
        </div>

        <a href="/users/auth/google" class="btn btn-outline-secondary w-100 py-2 rounded-3 d-flex align-items-center justify-content-center gap-2">
          <i class="fa-brands fa-google text-danger"></i> Continue with Google
        </a>

        <div class="text-center mt-4 pt-2 border-top">
          <span class="text-muted small">Already have an account?</span>
          <a href="/users/login" class="fw-semibold text-danger text-decoration-none ms-1">Log in</a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const input = document.getElementById("username");
    const statusDiv = document.getElementById("usernameStatus");
    let timeout = null;

    async function checkAvailability() {
      const val = input.value.trim();
      if (!val) {
        statusDiv.className = "mt-2 small text-muted";
        statusDiv.innerHTML = "";
        return;
      }
      if (val.length < 3) {
        statusDiv.className = "mt-2 small text-warning";
        statusDiv.innerHTML = '<i class="fa-solid fa-triangle-exclamation me-1"></i> Username must be at least 3 characters.';
        return;
      }
      if (!/^[a-zA-Z0-9_]+$/.test(val)) {
        statusDiv.className = "mt-2 small text-danger";
        statusDiv.innerHTML = '<i class="fa-solid fa-circle-xmark me-1"></i> Only letters, numbers, and underscores allowed.';
        return;
      }

      statusDiv.className = "mt-2 small text-secondary";
      statusDiv.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Checking availability...';

      try {
        const res = await fetch(`/users/check-username?username=${encodeURIComponent(val)}`);
        const data = await res.json();

        if (data.available) {
          statusDiv.className = "mt-2 small text-success fw-semibold";
          statusDiv.innerHTML = `<i class="fa-solid fa-circle-check me-1"></i> ${data.message}`;
        } else {
          statusDiv.className = "mt-2 small text-danger fw-semibold";
          statusDiv.innerHTML = `<i class="fa-solid fa-circle-xmark me-1"></i> ${data.message}`;
        }
      } catch (err) {
        statusDiv.className = "mt-2 small text-muted";
        statusDiv.innerHTML = "";
      }
    }

    input.addEventListener("input", () => {
      clearTimeout(timeout);
      timeout = setTimeout(checkAvailability, 300);
    });

    if (input.value) {
      checkAvailability();
    }
  });
</script>



